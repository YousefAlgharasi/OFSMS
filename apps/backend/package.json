{
  "name": "@ofsms/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "start:prod": "npm run predeploy && node src/index.js",
    "seed": "node scripts/seed.js",
    "create-admin": "node scripts/create-admin.js",
    "predeploy": "node src/db/migrate.js && node scripts/reset-data.js && node scripts/create-admin.js --if-configured",
    "migrate": "node src/db/migrate.js",
    "test": "jest"
  },
  "dependencies": {
    "aws-sdk": "^2.1693.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.18.3",
    "express-validator": "^7.0.1",
    "firebase-admin": "^13.8.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "next": "16.2.4",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.15.0",
    "pg": "^8.11.3",
    "puppeteer-core": "^25.0.2"
  },
  "jest": {
    "testPathIgnorePatterns": ["/node_modules/", "/scripts/"]
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "nodemon": "^3.1.0"
  }
}
